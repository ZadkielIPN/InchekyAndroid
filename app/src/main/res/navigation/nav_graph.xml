<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_resource"
        app:destination="@id/resourceFragment" />

    <action
        android:id="@+id/action_global_profile"
        app:destination="@id/profileFragment" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.inchekyandroid.ui.login.LoginFragment"
        android:label="@string/login_title">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.inchekyandroid.ui.register.RegisterFragment"
        android:label="@string/register_title">
        <action
            android:id="@+id/action_register_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.inchekyandroid.ui.home.DashboardFragment"
        android:label="@string/home_title">
        <action
            android:id="@+id/action_dashboard_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_dashboard_to_resource"
            app:destination="@id/resourceFragment" />
        <action
            android:id="@+id/action_dashboard_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.inchekyandroid.ui.home.ProfileFragment"
        android:label="@string/home_profile" />

    <fragment
        android:id="@+id/resourceFragment"
        android:name="com.example.inchekyandroid.ui.home.ResourceFragment"
        android:label="@string/home_title">
        <argument
            android:name="resource"
            app:argType="string" />
        <argument
            android:name="createOnOpen"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>
</navigation>
