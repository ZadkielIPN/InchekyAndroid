<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.InchekyAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/auth_primary</item>
        <item name="colorSecondary">@color/auth_secondary</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/auth_ink</item>
        <item name="textInputStyle">@style/Widget.Incheky.TextInputLayout</item>
    </style>

    <style name="Widget.Incheky.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/auth_muted</item>
    </style>

    <style name="Theme.InchekyAndroid" parent="Base.Theme.InchekyAndroid" />
</resources>