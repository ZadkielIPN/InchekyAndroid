<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_background_gradient"
    tools:context=".ui.login.LoginFragment">

    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_5">

            <ImageView
                android:layout_width="@dimen/auth_login_logo_size"
                android:layout_height="@dimen/auth_login_logo_size"
                android:layout_marginBottom="@dimen/space_2"
                android:contentDescription="@string/app_logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/incheky_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/auth_brand_full"
                android:textColor="@color/ink"
                android:textSize="@dimen/brand_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="@color/auth_ink"
                android:textSize="@dimen/screen_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:layout_marginBottom="@dimen/space_5"
                android:text="@string/auth_subtitle"
                android:textColor="@color/muted_on_line"
                android:textSize="@dimen/body_text_size" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:contentPadding="@dimen/space_5"
                app:strokeColor="@color/line"
                app:strokeWidth="@dimen/card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        android:text="@string/login_title"
                        android:textColor="@color/auth_ink"
                        android:textSize="@dimen/section_title_text_size"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.Incheky.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_3"
                        android:hint="@string/login_email"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.Incheky.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_2"
                        android:hint="@string/login_password"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_3"
                        android:background="@drawable/error_notice_background"
                        android:padding="@dimen/space_3"
                        android:textColor="@color/danger"
                        android:textSize="@dimen/body_text_size"
                        android:visibility="gone"
                        tools:text="Mensaje del inicio de sesión"
                        tools:visibility="visible" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogin"
                            style="@style/Widget.Incheky.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/login_button"
                            android:textSize="@dimen/body_text_size" />

                        <ProgressBar
                            android:id="@+id/loginProgress"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="@dimen/auth_progress_size"
                            android:layout_height="@dimen/auth_progress_size"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="@dimen/space_3"
                            android:importantForAccessibility="no"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/login_register_prompt"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/body_text_size" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegister"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:text="@string/register_link"
                        android:textAllCaps="false"
                        android:textColor="@color/auth_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
