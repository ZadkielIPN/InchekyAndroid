<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resourceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResourceBack"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/navigation_back"
        android:text="@string/navigation_back"
        android:textAllCaps="false"
        android:textColor="@color/auth_primary"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/auth_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvResourceTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:textColor="@color/auth_ink"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnResourceBack"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/searchControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResourceTitle">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilResourceQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/resource_search"
            android:layout_marginEnd="8dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/input_stroke"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/auth_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResourceQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResourceSearch"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/resource_search_action"
            android:text="@string/resource_search_action"
            android:textAllCaps="false"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/auth_primary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResourceCreate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/resource_create"
        android:textAllCaps="false"
        app:backgroundTint="@color/auth_primary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchControls" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResourceImage"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/resource_choose_image"
        android:textAllCaps="false"
        android:visibility="gone"
        app:icon="@drawable/ic_image"
        app:iconTint="@color/auth_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnResourceCreate" />

    <ScrollView
        android:id="@+id/resourceScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/resourcePager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnResourceImage">

        <LinearLayout
            android:id="@+id/resourceRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/resourcePager"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviousPage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resource_previous"
            android:textAllCaps="false"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/auth_primary" />

        <TextView
            android:id="@+id/tvPageNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/auth_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextPage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resource_next"
            android:textAllCaps="false"
            app:icon="@drawable/ic_arrow_forward"
            app:iconTint="@color/auth_primary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
