<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resourceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft">

    <LinearLayout
        android:id="@+id/searchControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/screen_margin"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilResourceQuery"
            style="@style/Widget.Incheky.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/resource_search"
            app:boxBackgroundMode="outline"
            app:endIconMode="clear_text"
            app:endIconTint="@color/muted"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResourceQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResourceImage"
        style="@style/Widget.Incheky.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/screen_margin"
        android:text="@string/resource_choose_image"
        android:visibility="gone"
        app:icon="@drawable/ic_image"
        app:iconTint="@color/accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchControls" />

    <ScrollView
        android:id="@+id/resourceScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/list_fab_clearance"
        app:layout_constraintBottom_toTopOf="@id/resourcePager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnResourceImage">

        <LinearLayout
            android:id="@+id/resourceRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/resourceLoading"
        style="?android:attr/progressBarStyle"
        android:layout_width="@dimen/space_6"
        android:layout_height="@dimen/space_6"
        android:indeterminateTint="@color/accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/resourceScroll"
        app:layout_constraintEnd_toEndOf="@id/resourceScroll"
        app:layout_constraintStart_toStartOf="@id/resourceScroll"
        app:layout_constraintTop_toTopOf="@id/resourceScroll" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnResourceCreate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_2"
        android:contentDescription="@string/resource_create"
        android:visibility="gone"
        app:backgroundTint="@color/accent"
        app:layout_constraintBottom_toTopOf="@id/resourcePager"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/resourcePager"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviousPage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:text="@string/resource_previous"
            android:textAllCaps="false"
            android:textColor="@color/pager_text_tint"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/pager_text_tint" />

        <TextView
            android:id="@+id/tvPageNumber"
            style="@style/TextAppearance.Incheky.MutedOnSoft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:text="@string/resource_page_default" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextPage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="@string/resource_next"
            android:textAllCaps="false"
            android:textColor="@color/pager_text_tint"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/pager_text_tint" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
